# ==========================================
# RepoClaw 环境配置示例 (.env.example)
# ==========================================

# 1. GitHub App 配置 (https://github.com/settings/apps)
# App ID
APP_ID=123456
# GitHub App 私钥 (直接粘贴单行或 base64，生产推荐 private-key.pem 映射)
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GitHub Webhook 密钥
WEBHOOK_SECRET=your_webhook_secret_here

# 2. Redis 异步队列配置
REDIS_URL=redis://127.0.0.1:6379

# 3. 数据库持久化配置 (SQLite / LibSQL)
DATABASE_URL=file:repoclaw.db

# 4. 大语言模型配置 (支持 OpenAI 兼容 API：DeepSeek、Qwen、Claude 等)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型标识 (默认 deepseek-chat，或 deepseek-coder、qwen-max 等)
MODEL_NAME=deepseek-chat

# 5. 执行与熔断调优
# 最大自愈反思重试轮次
MAX_RETRIES=3
# 沙箱单次执行硬熔断超时 (毫秒，默认 30 秒)
SANDBOX_TIMEOUT_MS=30000
# 服务端口
PORT=3000
